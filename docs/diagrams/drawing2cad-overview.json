    {
      "dot": "cyan",
      "title": "Demo flow",
      "items": [
        "1 Drawing, 2 Recognized, 3 Review, 4 3D model",
        "Review lists unclear strokes and '?' text: marked, not guessed",
        "Tab 4 shows a pipeline STEP, meshed to GLB on the server"
      ]
    },
    {
      "dot": "emerald",
      "title": "Built-in drawing analysis",
      "items": [
        "Page 1: classified strokes, views, and candidate glyph text",
        "Demo and MCP call the same Python PDF service",
        "Separate process per request; inspect critical values in images",
        "No standalone extractor package or CLI"
      ]
    },
    {
      "dot": "rose",
      "title": "Rules",
      "items": [
        "Ground-truth STEP files are never a pipeline input",
        "Drawing first, then 3D model, STEP export last",
        "Uploaded PDFs stay in a temp directory, not stored"
      ]
    },
    {
      "dot": "cyan",
      "title": "MCP transport",
      "items": [
        "Streamable HTTP clients share one FreeCAD proxy and CAD state",
        "Stdio remains available; HTTP does not make FreeCAD headless",
        "Headless CAD and semantic AP242 still require separate tests"
      ]
    }
  ]
