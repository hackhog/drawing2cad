  "cards": [
    {
      "dot": "cyan",
      "title": "M2 MCP: shared services",
      "items": [
        "PDF bytes arrive through bounded resumable uploads",
        "Source, run, job, and artifact IDs keep paths internal",
        "Persistent jobs, notes, revisions, and review gates",
        "MCP and web routes share one Python service"
      ]
    },
    {
      "dot": "emerald",
      "title": "Headless worker boundary",
      "items": [
        "Landlock, seccomp, finite resources, and timeouts",
        "No CAD GUI, FreeCAD proxy, or Docker socket",
        "Fresh STEP import validates the AP214 candidate",
        "Supplied 2D views become native DXF dimensions and PDF"
      ]
    },
    {
      "dot": "rose",
      "title": "Web delivery and acceptance follow-up",
      "items": [
        "Web routes and agent runs share one service instance",
        "No automatic arbitrary projection or section extraction",
        "Drawing review follows the current model build",
        "Resource acceptance remains deferred until milestones finish"
      ]
    },
    {
      "dot": "cyan",
      "title": "M3: bounded adapter, open",
      "items": [
        "AP242 with application construction and nominal PMI",
        "Fresh worker replay and parameter-change checks",
        "PDF input only; CAD-specific exports are separate",
        "STEPcode checks and actual stored-PMI inspection views"
      ]
    }
  ]
