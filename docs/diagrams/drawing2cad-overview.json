  "cards": [
    {
      "dot": "cyan",
      "title": "Demo containers",
      "items": [
        "nginx serves the UI and sends /api requests to FastAPI",
        "Only the frontend port is published on the host",
        "The backend uses MCP PDF preparation and review checks",
        "The viewer displays an uploaded STEP file as a GLB mesh"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared analysis code",
      "items": [
        "Demo and MCP load the same drawing2cad_mcp PDF service",
        "Each runtime starts a separate vector process per request",
        "Page 1: classified strokes, views, and candidate glyph text",
        "Inspect critical values in images; no standalone extractor"
      ]
    },
    {
      "dot": "rose",
      "title": "Workflow requirements",
      "items": [
        "Validation-only STEP files are not construction inputs",
        "Create and review a dimensioned drawing before the 3D model",
        "Keep model operations editable; export STEP last",
        "Uploaded demo files use temporary storage"
      ]
    },
    {
      "dot": "cyan",
      "title": "MCP scope",
      "items": [
        "Streamable HTTP clients share one FreeCAD proxy and CAD state",
        "The MCP runtime is separate from the demo HTTP backend",
        "HTTP transport does not make the FreeCAD upstream headless",
        "Headless CAD and semantic AP242 need separate validation"
      ]
    }
  ]
