# Optional model endpoint for agent runs (ADR 0018). Copy to .env; .env is not in Git.
# From the repository root, use docker compose --env-file .env -f deployment/compose.yaml.
# Use the same --env-file option with deployment/compose.local.yaml. Shell values have priority.
# Any OpenAI-compatible Chat Completions or Responses endpoint works. Without these values, "Lauf starten" is unavailable.

# Azure AI Foundry (OpenAI v1 API):
DRAWING2CAD_AGENT_BASE_URL=https://<resource>.cognitiveservices.azure.com/openai/v1
# The model must support function tools on the selected API (see ADR 0018).
DRAWING2CAD_AGENT_MODEL=gpt-5.6-sol
DRAWING2CAD_AGENT_API_KEY=
DRAWING2CAD_AGENT_API_KEY_HEADER=api-key
# gpt-6.1-sol needs the Responses API:
# DRAWING2CAD_AGENT_MODEL=gpt-6.1-sol
# DRAWING2CAD_AGENT_API=responses
# DRAWING2CAD_AGENT_REASONING_EFFORT=medium

# OpenRouter or OpenAI: use the provider base URL and the default header (Authorization: Bearer).
# DRAWING2CAD_AGENT_BASE_URL=https://openrouter.ai/api/v1
# DRAWING2CAD_AGENT_MODEL=<provider>/<model>
# DRAWING2CAD_AGENT_API_KEY=

# Run limits of a profile (ADR 0028), for example for a small local model. Unset limits use the defaults.
# DRAWING2CAD_AGENT_STEP_BUDGET=30
# DRAWING2CAD_AGENT_MODEL_TIMEOUT_SECONDS=900
# Maximum of each limit for all profiles:
# DRAWING2CAD_RUN_MAX_TOTAL_TIMEOUT_SECONDS=14400

# Master key for API keys that users add in the web UI (ADR 0028). Without it, the UI cannot save keys.
# Make one with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy outside the data volume. A changed master key locks the stored keys.
DRAWING2CAD_SECRET_KEY=
# Or a file, for example a Docker secret (it has priority):
# DRAWING2CAD_SECRET_KEY_FILE=/run/secrets/drawing2cad_master_key

# More than one profile (ADR 0020): list the names. Each profile reads DRAWING2CAD_AGENT_<NAME>_* with the
# suffixes above, and the unprefixed variables are not used. The first complete profile is active at start;
# users select another one in the web UI under Einstellungen, where they can also add profiles with keys.
# A profile without key is skipped.
# DRAWING2CAD_AGENT_PROFILES=Foundry,OpenRouter
# DRAWING2CAD_AGENT_FOUNDRY_BASE_URL=https://<resource>.cognitiveservices.azure.com/openai/v1
# DRAWING2CAD_AGENT_FOUNDRY_MODEL=gpt-6.1-sol
# DRAWING2CAD_AGENT_FOUNDRY_API=responses
# DRAWING2CAD_AGENT_FOUNDRY_API_KEY=
# DRAWING2CAD_AGENT_FOUNDRY_API_KEY_HEADER=api-key
# DRAWING2CAD_AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DRAWING2CAD_AGENT_OPENROUTER_MODEL=<provider>/<model>
# DRAWING2CAD_AGENT_OPENROUTER_API_KEY=
