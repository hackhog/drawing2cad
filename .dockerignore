# The backend context contains the MCP package and backend source only.
# The frontend image uses app/frontend/ and its own .dockerignore.
*
!drawing2cad-mcp/
!app/backend/
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
drawing2cad-mcp/tests
drawing2cad-mcp/*.local.toml
drawing2cad-mcp/output
app/backend/tests
app/backend/scripts
